+    calls.push([pathValue, options.method]);
+    if (options.method === 'DELETE') {
+      const error = new Error('ya venció');
+      error.status = 404;
+      throw error;
+    }
+    return { ok: true, data: capabilityData({ active_session: null }) };
+  });
+  seedFrontendSession(harness.api.state);
