# Mantto Gestor - .env REAL TEMPLATE COMPLETO
# [Aster | 2026-08-11 | ASTER-MG | FASE 1.0 V2: ENV CONTRACT]
# Plantilla pública. NO colocar secretos reales.

# =========================
# Runtime / HTTP
# =========================
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
JSON_LIMIT=12mb
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# =========================
# MySQL / Aiven
# =========================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=mydb
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000

# Variable oficial consumida por backend/src/config/db.js
DB_SSL_REJECT_UNAUTHORIZED=true

# Variable legacy actualmente presente en Azure.
# Mantener temporalmente hasta retirar la referencia de configuración antigua.
DB_SSL=

# =========================
# JWT / sesiones
# =========================
JWT_SECRET=
JWT_EXPIRES_IN=12h

# =========================
# Portafolio - cierre mensual
# =========================
PORTAFOLIO_CIERRE_MENSUAL_ENABLED=true
PORTAFOLIO_CIERRE_TZ=America/Mexico_City
PORTAFOLIO_CIERRE_HOUR=23
PORTAFOLIO_CIERRE_MINUTE=59

# =========================
# Portafolio - cierre semanal
# =========================
PORTAFOLIO_CIERRE_SEMANAL_ENABLED=true
PORTAFOLIO_CIERRE_SEMANAL_TZ=America/Mexico_City
PORTAFOLIO_CIERRE_SEMANAL_HOUR=12
PORTAFOLIO_CIERRE_SEMANAL_MINUTE=0

# =========================
# Google OAuth / Drive
# =========================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/drive.readonly
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Instalaciones - Drive
INSTALACIONES_DRIVE_ROOT_FOLDER_ID=
INSTALACIONES_DRIVE_ROOT_FOLDER_NAME=Instalaciones

# Ventas - Prospección Drive
VENTAS_PROSPECCION_DRIVE_FOLDER_ID=

# =========================
# Web Push
# =========================
WEB_PUSH_ENABLED=true
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
WEB_PUSH_DISPATCH_INTERVAL_MS=5000
WEB_PUSH_REQUEST_TIMEOUT_MS=12000
WEB_PUSH_BATCH_SIZE=300
WEB_PUSH_NOTIFICATIONS_PER_CYCLE=20

# =========================
# CFFAA - General
# =========================
CFFAA_SCHEMA_CACHE_MS=60000
CFFAA_HISTORICAL_SYNC_ENABLED=false
CFFAA_PRODUCTION_DIAGNOSTICS_OVERRIDE=false
CFFAA_LEGACY_UPLOADS_ENABLED=true

# =========================
# Azure Blob Storage
# =========================
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_BLOB_CONTAINER_NAME=
AZURE_STORAGE_DIAGNOSTICS_ENABLED=false
AZURE_STORAGE_MAX_FILE_MB=25
AZURE_STORAGE_SAS_MINUTES=15
AZURE_STORAGE_DELEGATION_KEY_MINUTES=60

# =========================
# CFFAA - Upload contract
# =========================
CFFAA_STORAGE_MAX_REQUEST_MB=50
CFFAA_STORAGE_FIELD_SIZE_MB=2
CFFAA_FILE_SIGNATURE_VALIDATION=true

# =========================
# CFFAA - Storage retry
# =========================
CFFAA_STORAGE_RETRY_ENABLED=false
CFFAA_STORAGE_RETRY_INTERVAL_MS=60000
CFFAA_STORAGE_RETRY_BATCH_SIZE=20
CFFAA_STORAGE_RETRY_STALE_MINUTES=15
CFFAA_STORAGE_RETRY_MAX_ATTEMPTS=10
CFFAA_STORAGE_RETRY_BASE_SECONDS=60
CFFAA_STORAGE_RETRY_MAX_SECONDS=3600

# =========================
# CFFAA - SAS access
# =========================
CFFAA_STORAGE_ACCESS_VERIFY_EXISTS=false
CFFAA_STORAGE_ACCESS_AUDIT_LOG=true

# =========================
# CFFAA - Reconciliation / metrics
# =========================
CFFAA_STORAGE_RECONCILIATION_ENABLED=false
CFFAA_STORAGE_RECONCILIATION_MAX_BLOBS=5000
CFFAA_STORAGE_RECONCILIATION_MAX_DB_CHECKS=1000
CFFAA_STORAGE_RECONCILIATION_SAMPLE_LIMIT=200
CFFAA_STORAGE_METRICS_ENABLED=false

# =========================
# CFFAA - Orphan cleanup
# =========================
CFFAA_STORAGE_ORPHAN_DELETE_ENABLED=false
CFFAA_STORAGE_ORPHAN_MIN_AGE_HOURS=24
CFFAA_STORAGE_ORPHAN_MAX_DELETE=50

# =========================
# Azure App Service platform
# =========================
WEBSITE_HTTPLOGGING_RETENTION_DAYS=

# ============================================================
# FUTURO - AUTENTICACIÓN M2M PARA APPS SCRIPT
# ============================================================
# NO EXISTE TODAVÍA requireIntegrationAuth en el código actual.
# Por seguridad NO se inventan variables activas en esta plantilla.
# Las claves M2M se agregarán aquí cuando la Fase 5 defina el contrato
# y el backend realmente las consuma.
