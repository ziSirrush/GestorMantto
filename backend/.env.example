NODE_ENV=development
HOST=0.0.0.0
PORT=3001
JSON_LIMIT=12mb

# Frontends permitidos, separados por coma.
# En desarrollo, localhost/127.0.0.1 y redes privadas RFC1918 se aceptan automaticamente
# aunque el puerto cambie (por ejemplo Live Server). En produccion usa origenes exactos.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Base de datos MySQL / Aiven
DB_HOST=TU_HOST_AIVEN
DB_PORT=TU_PUERTO_AIVEN
DB_USER=TU_USUARIO_AIVEN
DB_PASSWORD=TU_PASSWORD_AIVEN
DB_NAME=mydb
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
# TLS hacia Aiven. Contrato unico para local y Azure.
DB_SSL=true

# Autenticacion Mantto Gestor
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_SEGURO
# El access JWT tiene una vigencia fija de 12 horas en codigo. La sesion
# renovable conserva un limite absoluto de 90 dias.

# Corte semanal de Portafolio: domingo 12:00 hrs CDMX
PORTAFOLIO_CIERRE_SEMANAL_ENABLED=true
PORTAFOLIO_CIERRE_SEMANAL_TZ=America/Mexico_City
PORTAFOLIO_CIERRE_SEMANAL_HOUR=12
PORTAFOLIO_CIERRE_SEMANAL_MINUTE=0

# Google OAuth 2.0 / Drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/drive.readonly
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Drive - Gestor de carpetas de Instalaciones
# ID alfanumerico de la carpeta raiz que se mostrara en Detalle Proyecto.
INSTALACIONES_DRIVE_ROOT_FOLDER_ID=
INSTALACIONES_DRIVE_ROOT_FOLDER_NAME=Instalaciones

# Notificaciones Web Push globales
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:soporte@dominio.com
WEB_PUSH_DISPATCH_INTERVAL_MS=5000
WEB_PUSH_REQUEST_TIMEOUT_MS=12000
WEB_PUSH_BATCH_SIZE=300

# CFFAA-00 - controles de esquema y rutas técnicas
CFFAA_SCHEMA_CACHE_MS=60000
CFFAA_HISTORICAL_SYNC_ENABLED=false
AZURE_STORAGE_DIAGNOSTICS_ENABLED=false

# Azure Blob Storage privado (autenticacion mediante Managed Identity / Entra ID)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_BLOB_CONTAINER_NAME=
AZURE_STORAGE_SAS_MINUTES=15
AZURE_STORAGE_MAX_FILE_MB=25

# CFFAA-01 - contrato general de archivos
# Límite total de todos los archivos contenidos en una petición multipart.
CFFAA_STORAGE_MAX_REQUEST_MB=50
# Tamaño máximo de cada campo de texto dentro de multipart.
CFFAA_STORAGE_FIELD_SIZE_MB=2
# Valida la firma binaria contra la extensión. Mantener true en producción.
CFFAA_FILE_SIGNATURE_VALIDATION=true
# Duración de la llave de delegación reutilizada. Debe superar SAS_MINUTES por al menos 5 minutos.
AZURE_STORAGE_DELEGATION_KEY_MINUTES=60

# CFFAA-01D - reintentos de eliminaciones Azure pendientes
# Activar únicamente después de ejecutar la migración CFFAA-01D.
CFFAA_STORAGE_RETRY_ENABLED=false
CFFAA_STORAGE_RETRY_INTERVAL_MS=60000
CFFAA_STORAGE_RETRY_BATCH_SIZE=20
CFFAA_STORAGE_RETRY_STALE_MINUTES=15
CFFAA_STORAGE_RETRY_MAX_ATTEMPTS=10
CFFAA_STORAGE_RETRY_BASE_SECONDS=60
CFFAA_STORAGE_RETRY_MAX_SECONDS=3600

# CFFAA-01E - acceso SAS bajo demanda
# false evita una consulta adicional a Azure por cada apertura. Los módulos pueden forzarla por ruta.
CFFAA_STORAGE_ACCESS_VERIFY_EXISTS=false
# Registra quién generó una SAS sin imprimir la URL firmada.
CFFAA_STORAGE_ACCESS_AUDIT_LOG=true

# CFFAA-06 - conciliacion, metricas y cierre
# Habilita exclusivamente rutas tecnicas de conciliacion para Programador.
CFFAA_STORAGE_RECONCILIATION_ENABLED=false
# Limites del escaneo en Azure y verificaciones directas cuando el listado queda parcial.
CFFAA_STORAGE_RECONCILIATION_MAX_BLOBS=5000
CFFAA_STORAGE_RECONCILIATION_MAX_DB_CHECKS=1000
CFFAA_STORAGE_RECONCILIATION_SAMPLE_LIMIT=200
# Registra eventos de carga, acceso, rechazo, eliminacion y conciliacion. Activar despues de ejecutar la migracion CFFAA-06.
CFFAA_STORAGE_METRICS_ENABLED=false
# La limpieza de huerfanos permanece desactivada por defecto y requiere confirmacion exacta por peticion.
CFFAA_STORAGE_ORPHAN_DELETE_ENABLED=false
CFFAA_STORAGE_ORPHAN_MIN_AGE_HOURS=24
CFFAA_STORAGE_ORPHAN_MAX_DELETE=50
# Mantener true mientras existan archivos o referencias historicas bajo /uploads.
CFFAA_LEGACY_UPLOADS_ENABLED=true
# En produccion los diagnosticos CFFAA-01F quedan ocultos aunque AZURE_STORAGE_DIAGNOSTICS_ENABLED=true.
# Solo usar temporalmente durante una intervencion tecnica autorizada.
CFFAA_PRODUCTION_DIAGNOSTICS_OVERRIDE=false

# Integraciones maquina-a-maquina (M2M / HMAC)
# FASE 1: mantener false. Las rutas se protegeran en FASE 2.
INTEGRATION_AUTH_ENABLED=false
INTEGRATION_HMAC_ALGORITHM=sha256
INTEGRATION_TIMESTAMP_TOLERANCE_SECONDS=300
INTEGRATION_REPLAY_PROTECTION_ENABLED=true
INTEGRATION_AUDIT_ENABLED=true
INTEGRATION_MAX_BODY_BYTES=12582912

INTEGRATION_HEADER_ID=X-Integration-Id
INTEGRATION_HEADER_TIMESTAMP=X-Integration-Timestamp
INTEGRATION_HEADER_SIGNATURE=X-Integration-Signature

INTEGRATION_TICKETS_ID=tickets-appscript
INTEGRATION_TICKETS_SECRET=

INTEGRATION_PORTAFOLIO_ID=portafolio-appscript
INTEGRATION_PORTAFOLIO_SECRET=

INTEGRATION_INS_FL_ID=ins-fl-appscript
INTEGRATION_INS_FL_SECRET=

INTEGRATION_LOGISTICA_ID=logistica-appscript
INTEGRATION_LOGISTICA_SECRET=

INTEGRATION_INSTALACIONES_DRIVE_ID=instalaciones-drive-appscript
INTEGRATION_INSTALACIONES_DRIVE_SECRET=

INTEGRATION_VENTAS_ID=ventas-appscript
INTEGRATION_VENTAS_SECRET=

# Logistica -> Produccion V003
LOGISTICA_CIERRE_SEMANAL_ENABLED=true
LOGISTICA_CIERRE_SEMANAL_TZ=America/Mexico_City
LOGISTICA_CIERRE_SEMANAL_HOUR=12
LOGISTICA_CIERRE_SEMANAL_MINUTE=0

# Alerta global de Almacen: avisa tras 4 h con un cierre distinto al mes anterior,
# solo si el Excel esperado ya esta archivado y solo a usuarios con permiso de carga.
ALMACEN_CIERRE_ALERT_ENABLED=true
ALMACEN_CIERRE_ALERT_TZ=America/Mexico_City
ALMACEN_CIERRE_ALERT_INTERVAL_MS=300000
# Produccion aplica en código el contrato fijo: 25 MB por archivo,
# 2 slots CPVO y 10 slots GM (12 archivos activos en total).

# Panel de Control -> Prueba de Carga
# Techo operativo configurable del entorno. 200 es la meta inicial de pruebas,
# NO un limite arquitectonico del modulo; puede elevarse (por ejemplo a 1000)
# cuando la infraestructura y el plan de prueba lo autoricen.
LOAD_TEST_MIN_VUS=10
LOAD_TEST_VUS_STEP=10
LOAD_TEST_MAX_VUS=200

# Fase 3 runner externo. V001 falla cerrado si estas dos variables no estan listas.
# LOAD_TEST_SINGLE_INSTANCE=true es una confirmacion operativa del despliegue:
# debe existir una sola replica / un solo proceso backend mientras corre la prueba.
LOAD_TEST_SINGLE_INSTANCE=false
# Origen exacto autorizado del backend Mantto Gestor. No incluir ruta, query ni fragmento.
LOAD_TEST_ALLOWED_ORIGIN=https://mantto-gestor-api-a4hwfpgvbeb4gmgj.mexicocentral-01.azurewebsites.net

# Panel de Control -> Prueba de Carga -> Fase 2 telemetria efimera
# La sesion LISTA expira si no se inicia. Los resultados finalizados viven solo en RAM
# durante el TTL para permitir copiar el reporte; no se persisten en BD ni archivos.
LOAD_TEST_READY_TTL_SECONDS=900
LOAD_TEST_RESULT_TTL_SECONDS=900
LOAD_TEST_ACTIVE_GRACE_SECONDS=120
# Fase 4: canal de control del runner, cierre y protecciones de Produccion.
LOAD_TEST_RUNNER_CONTROL_POLL_MS=1000
LOAD_TEST_FINALIZATION_TIMEOUT_SECONDS=20
LOAD_TEST_SUMMARY_TIMEOUT_SECONDS=15
LOAD_TEST_DRAIN_TIMEOUT_SECONDS=5
LOAD_TEST_PROTECTION_MIN_REQUESTS=30
LOAD_TEST_PROTECTION_5XX_PERCENT=10
LOAD_TEST_PROTECTION_P95_MS=5000
# Ventana movil para RPS/p95 en vivo y abortos por 5xx/latencia.
LOAD_TEST_LIVE_WINDOW_SECONDS=10
LOAD_TEST_TELEMETRY_SAMPLE_MS=1000
LOAD_TEST_SLOW_QUERY_MS=750
# Limites de memoria del colector. No son limites de usuarios concurrentes.
LOAD_TEST_MAX_SYSTEM_SAMPLES=600
LOAD_TEST_MAX_ENDPOINTS=100
LOAD_TEST_MAX_FINGERPRINTS=100
LOAD_TEST_MAX_LATENCY_SAMPLES=4096
LOAD_TEST_MAX_ENDPOINT_LATENCY_SAMPLES=512
