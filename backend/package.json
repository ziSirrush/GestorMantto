{
  "name": "mantto-gestor-backend",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Backend modular de Mantto Gestor",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/validate-structure.js && node scripts/validate-clean-tree.js",
    "test": "npm run test:unit && npm run test:validation && npm run test:backend && npm run test:contracts && npm run test:storage",
    "test:unit": "node --test --test-concurrency=4 ../tests/*.test.js ../tests/*.test.cjs",
    "test:validation": "node --test --test-concurrency=4 ../validation/*.test.js",
    "test:backend": "node --test --test-concurrency=4 tests/*.test.js",
    "test:contracts": "node --test --test-concurrency=4 scripts/test-*.js",
    "test:storage": "node scripts/validate-cffaa-01.js && node scripts/validate-cffaa-01ef.js && node scripts/validate-cffaa-06.js",
    "qa:seguimiento": "node scripts/QA_MONITOR_SEGUIMIENTO_TICKET_V001.js",
    "qa:instalaciones:fix3:readonly": "node ../validation/instalaciones-administracion-fix3-autoguardado-readonly.js",
    "qa:instalaciones:fix4:readonly": "node ../validation/instalaciones-administracion-fix4-readonly-smoke.js",
    "qa:cx:readonly": "node ../tests/cx-visitas-fase2-http-smoke.cjs",
    "qa:cx:staging": "node ../tests/cx-visitas-fase4-http-smoke.cjs",
    "validate:m2m": "node scripts/validate-m2m-auth.js",
    "check:db:utf8mb4": "node scripts/check-db-utf8mb4.js",
    "generate:vapid": "node scripts/generate-vapid-keys.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "@azure/identity": "4.13.0",
    "@azure/storage-blob": "^12.33.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  }
}
